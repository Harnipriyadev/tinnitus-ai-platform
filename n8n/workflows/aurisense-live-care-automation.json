        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ workflowId: $json.workflowId, step: 'care_plan', stepStatus: 'completed', message: $json.action, recommendedAction: $json.action, workflowStatus: 'running' }) }}",
        "options": {}
      },
      "id": "care-plan",
      "name": "Publish Care Plan",
      "type": "n8n-nodes-base.httpRequest",
