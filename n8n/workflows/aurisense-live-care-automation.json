        "options": {}
      },
      "id": "analysed",
      "name": "Publish Severity Result",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [140, 0]
    },
    {
      "parameters": {
        "jsCode": "const data = $('Validate and Normalize').item.json;\nconst plans = {\n  Mild: { action: 'Personalised self-care and sound-therapy guidance', days: 14 },\n  Moderate: { action: 'Personalised care plan and doctor consultation suggested', days: 7 },\n  Severe: { action: 'Priority ENT consultation recommended', days: 3 },\n  Critical: { action: 'Urgent professional medical evaluation recommended', days: 1 }\n};\nreturn [{ json: { ...data, ...plans[data.severity] } }];"
      },
      "id": "plan",
      "name": "Create Severity-Based Plan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [360, 0]
    },
