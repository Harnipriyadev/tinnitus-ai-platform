{
  "name": "Aurisense AI - Live Care Automation",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "aurisense-care-automation",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook",
      "name": "Assessment Result Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-760, 0],
      "webhookId": "aurisense-care-automation"
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body || {};\nconst allowed = ['Mild', 'Moderate', 'Severe', 'Critical'];\nconst severity = allowed.includes(body.severity) ? body.severity : 'Moderate';\nif (!body.workflowId || !body.callbackUrl || !body.callbackSecret) {\n  throw new Error('Missing required automation fields');\n}\nreturn [{ json: {\n  workflowId: String(body.workflowId),\n  assessmentId: String(body.assessmentId || ''),\n  severity,\n  risk: String(body.risk || ''),\n  callbackUrl: String(body.callbackUrl),\n  callbackSecret: String(body.callbackSecret)\n} }];"
      },
      "id": "normalize",
      "name": "Validate and Normalize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-540, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.callbackUrl }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Aurisense-Callback-Secret",
              "value": "={{ $json.callbackSecret }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ workflowId: $json.workflowId, step: 'received', stepStatus: 'completed', message: 'Assessment securely received by the automation engine', workflowStatus: 'running' }) }}",
        "options": {}
      },
      "id": "received",
      "name": "Mark Assessment Received",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-300, 0]
    },
    {
      "parameters": {
        "amount": 1,
        "unit": "seconds"
      },
      "id": "wait-analysis",
      "name": "Live Pause - Analysis",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [-80, 0],
      "webhookId": "wait-analysis"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Validate and Normalize').item.json.callbackUrl }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
